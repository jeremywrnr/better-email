{
  "name": "better-email",
  "version": "1.3.1",
  "scripts": {
    "start": "web-ext run",
    "start:chrome": "web-ext run --target chromium",
    "build": "webpack",
    "check": "prettier . --check",
    "fix": "prettier . --write",
    "clean": "rm -rf  dist/ web-ext-artifacts/",
    "publish": "webpack --no-watch --mode production && web-ext build --overwrite-dest",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=120000 \"test/integration/*.test.mjs\""
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-loader": "^9.2.1",
    "prettier": "^3.9.10",
    "terser-webpack-plugin": "^5.3.11",
    "web-ext": "^10.5.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "imports": {
    "#cdp": "./test/integration/cdp.mjs"
  }
}
