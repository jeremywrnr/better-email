{
  "manifest_version": 3,
  "name": "Better Email",
  "version": "1.4.0",
  "description": "Declutter Gmail: hide Gemini, AI summaries and other clutter. Copy conversation links and sender addresses.",
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "128": "media/icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["dist/content.bundle.js"]
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["dist/loading.bundle.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "better-gmail-helper@jeremy",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
